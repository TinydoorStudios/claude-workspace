# ShowBuilder env — Phase 2 (n8n VM). Copy to /etc/showbuilder.env (root:600).
# The Proxmox instance is CAPTURE-ONLY: it runs the wizard and emits a facts-only
# <Show>.brief.json to download; it never computes EQ, writes the .ses, or paperwork.
SHOWBUILDER_ROLE=package
SHOWBUILDER_PORT=8095
SHOWBUILDER_HOST=127.0.0.1
# Gate the dashboard behind a passcode (Brian defines this in phase 2).
SHOWBUILDER_PASSCODE=
# audio_root is left unset on the VM — no templates/patchers there.
SHOWBUILDER_AUDIO_ROOT=
