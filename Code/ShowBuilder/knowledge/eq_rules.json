  "blends": {
    "_note": "Two mics on one source, blended as ONE signal. The engine detects same-source mic pairs (shared name stem + same section) and shapes the complement mic to stay out of the primary's midrange, then emits polarity/bus/VCA guidance. Add known pairs below for tailored text.",
    "overlap_roles": [
      "body",
      "mud",
      "box",
      "honk",
      "presence",
      "warmth",
      "proximity",
      "crack"
    ],
    "complement_scale": 0.5,
    "pairs": {
      "Shure SM57|Shure Beta 27": "57 = midrange grit + presence core; Beta 27 = clean low-end body and the airy top (5.5k/9k) the 57 lacks. Keep the 57 owning mids — don't double them.",
      "Shure SM57|Royer R-121": "AxeMount: 57 is primary for level/grit; the R-121 ribbon blends up from zero to tame 57 brittleness (sits 6-10dB under; 3-5dB for warm GD/Allmans tones). NO 48V on the ribbon. Group both to one VCA.",
      "Shure SM57|Sennheiser MD421": "57 = bite/presence; 421 = low-mid girth + weight. Thick and powerful — watch the 200-400Hz stack.",
      "Shure SM57|Royer R-10": "57 = grit/presence; R-10 ribbon = body + smooth top, tames 57 fizz. NO 48V on the ribbon."
    },
    "generic": "Treat the pair as one signal: pan together, group to a VCA, keep the blend constant. Polarity: sum in mono and flip the polarity on one mic if the sum is thinner than either alone. Watch 300-500Hz buildup on the bus — notch -2 to -3dB if it stacks."
  }
}