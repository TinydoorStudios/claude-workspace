{
  "id": "internal-send-outlook",
  "name": "Internal Send — Outlook (Production@3cdc.org)",
  "active": true,
  "settings": {},
  "nodes": [
    {
      "id": "webhook-1",
      "name": "Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "internal-send-outlook",
      "parameters": {
        "path": "internal-send-outlook",
        "httpMethod": "POST",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "code-1",
      "name": "Check Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const EXPECTED_TOKEN = 'REPLACE_WITH_ADVANCE_INTERNAL_TOKEN';\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst token = headers['x-advance-token'];\nif (token !== EXPECTED_TOKEN) {\n  return [];\n}\nreturn [{ json: item.json }];"
      }
    },
    {
      "id": "http-1",
      "name": "Send via Graph",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        300
      ],
      "parameters": {
        "url": "https://graph.microsoft.com/v1.0/users/production@3cdc.org/sendMail",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify((() => { const b = $json.body || $json; return { message: { subject: b.subject, body: { contentType: 'HTML', content: b.html }, toRecipients: [ { emailAddress: { address: b.to || 'blloyd@3cdc.org' } } ] }, saveToSentItems: true }; })()) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "oAuth2Api": {
          "id": "REPLACE_WITH_GRAPH_CREDENTIAL_ID",
          "name": "Microsoft Graph - Production@3cdc.org (App-only)"
        }
      }
    }
  ],
  "connections": {
    "Trigger": {
      "main": [
        [
          {
            "node": "Check Token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Token": {
      "main": [
        [
          {
            "node": "Send via Graph",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
