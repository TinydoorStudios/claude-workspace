{
  "id": "internal-delete-outlook-drafts",
  "name": "Internal Delete Outlook Drafts — by Band (Production@3cdc.org)",
  "active": true,
  "settings": {},
  "nodes": [
    {
      "id": "webhook-1",
      "name": "Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "internal-delete-outlook-drafts",
      "parameters": {
        "path": "internal-delete-outlook-drafts",
        "httpMethod": "POST",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "code-1",
      "name": "Check Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const EXPECTED_TOKEN = 'REPLACE_WITH_ADVANCE_INTERNAL_TOKEN';\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst token = headers['x-advance-token'];\nif (token !== EXPECTED_TOKEN) {\n  return [];\n}\nconst b = item.json.body || item.json;\nconst email = (b.email || '').trim().toLowerCase();\nif (!email) return [];\nreturn [{ json: { band: (b.band || '').trim(), email } }];"
      }
    },
    {
      "id": "http-list",
      "name": "List Drafts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300],
      "parameters": {
        "url": "https://graph.microsoft.com/v1.0/users/production@3cdc.org/mailFolders/drafts/messages",
        "method": "GET",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "$top", "value": "200" },
            { "name": "$select", "value": "id,subject,toRecipients" }
          ]
        },
        "options": {
          "response": { "response": { "fullResponse": true, "neverError": true } }
        }
      },
      "credentials": {
        "oAuth2Api": {
          "id": "REPLACE_WITH_GRAPH_CREDENTIAL_ID",
          "name": "Microsoft Graph - Production@3cdc.org (App-only)"
        }
      }
    },
    {
      "id": "code-match",
      "name": "Find Matches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crit = $('Check Token').first().json;\nconst email = crit.email;\nif (!email) return [];\nconst resp = $input.first().json;\nconst body = resp.body || resp;\nconst drafts = body.value || [];\n// Match by recipient address only — the subject is series-based (e.g.\n// \"513 Airwaves\"), never the band's own name, so it's not a usable key.\nconst hits = drafts.filter(d => {\n  const recips = (d.toRecipients || []).map(r => ((r.emailAddress || {}).address || '').toLowerCase());\n  return recips.includes(email);\n});\nreturn hits.map(d => ({ json: { id: d.id, subject: d.subject } }));"
      }
    },
    {
      "id": "http-delete",
      "name": "Delete Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 300],
      "parameters": {
        "url": "=https://graph.microsoft.com/v1.0/users/production@3cdc.org/messages/{{$json.id}}",
        "method": "DELETE",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {
          "response": { "response": { "fullResponse": true, "neverError": true } }
        }
      },
      "credentials": {
        "oAuth2Api": {
          "id": "REPLACE_WITH_GRAPH_CREDENTIAL_ID",
          "name": "Microsoft Graph - Production@3cdc.org (App-only)"
        }
      }
    }
  ],
  "connections": {
    "Trigger": { "main": [[{ "node": "Check Token", "type": "main", "index": 0 }]] },
    "Check Token": { "main": [[{ "node": "List Drafts", "type": "main", "index": 0 }]] },
    "List Drafts": { "main": [[{ "node": "Find Matches", "type": "main", "index": 0 }]] },
    "Find Matches": { "main": [[{ "node": "Delete Draft", "type": "main", "index": 0 }]] }
  }
}
