# Copy to /opt/band-advance/advance.env on the VM (gitignored).
# Loaded by the band-advance systemd unit (EnvironmentFile=).
#
# Regenerated 2026-09-16 (audit ops #4) from an actual grep of every
# ADVANCE_* / GROQ_API_KEY / DROPBOX_* os.environ.get() in app/ and tools/ — the
# previous copy of this file documented 7 of the ~17 vars the app
# actually reads. NEVER rewrite this file (or the real advance.env)
# partially — every var below, every time.
# 2026-09-21 sweep: ADVANCE_NOTIFY_URL + ADVANCE_LIFECYCLE_NOW_URL moved to
# required (code default "" silently disables them); DROPBOX_* added.

# ── required ─────────────────────────────────────────────────────────────
ADVANCE_DB_URL=postgresql://advance:change-me-strong@127.0.0.1:5433/advance
ADVANCE_SECRET=change-me-64-hex
ADVANCE_GATE_PASS=lockdown
ADVANCE_INTERNAL_TOKEN=change-me-64-hex
ADVANCE_PUBLIC_URL=https://advance.tinydoorstudios.com
# n8n webhooks on this same VM, called on localhost (Cloudflare's bot
# protection blocks the public tunnel for server-to-server calls). The code
# default "" silently disables each: NOTIFY = the booking-logged /
# form-completed quick-glance email; LIFECYCLE_NOW = the immediate welcome for
# a booking inside 21 days instead of waiting for the daily 9am lifecycle run.
ADVANCE_NOTIFY_URL=http://localhost:5678/webhook/advance-notify
ADVANCE_LIFECYCLE_NOW_URL=http://localhost:5678/webhook/advance-lifecycle-now

# ── optional ─────────────────────────────────────────────────────────────
# A second standing passcode — either one opens the gate. No source
# default any more (audit 2026-09-16 security #2/#7); blank = only
# ADVANCE_GATE_PASS works.
# ADVANCE_GATE_PASS_2=

# Slack incoming-webhook for a ping on each submission.
# ADVANCE_SLACK_WEBHOOK=https://hooks.slack.com/services/...

# Required for the Spanish-language form (?lang=es): translates a band's
# free-text answers to English on submit, before disk/DB/notify/doc-fill
# ever see them (see es_translate.py). Groq free tier — separate key from
# Code/GearTickets' own Groq credential (that one lives inside n8n's
# encrypted credential store, not reusable here). Without this set, a
# Spanish submission still works fine — the text just stays in Spanish.
# GROQ_API_KEY=gsk_...
# ADVANCE_TRANSLATE_MODEL=openai/gpt-oss-120b
# ADVANCE_TRANSLATE_TIMEOUT=15

# Where the "Dropbox root" is when it isn't ~/Dropbox — mainly for the
# staging harness, which points this at its own clone.
# ADVANCE_DROPBOX_ROOT=/home/brian/Dropbox

# Kill switch / staging isolation (mailer.py) — never set ADVANCE_MAIL_
# DISABLED=1 on the real live advance.env; it's for a manual run only.
# ADVANCE_MAIL_DISABLED=1
# ADVANCE_STAGING=1

# All optional — sane defaults already match this deploy (Flask + n8n on
# the same VM, Brian's own address). Override only if any ever changes.
# ADVANCE_INTERNAL_SEND_URL=http://localhost:5678/webhook/internal-send-outlook
# ADVANCE_CREATE_DRAFT_URL=http://localhost:5678/webhook/internal-create-outlook-draft
# ADVANCE_UNRESPONDED_ALERT_TO=blloyd@3cdc.org

# Stage-plot links in filed day sheets (tools/fieldspec.py dropbox_shared_link,
# used by daysheet.py + backfill_stageplot_links.py) via the Dropbox API app
# "band-advance-stageplot" (Full Dropbox, sharing.write+read; needs the dropbox
# pip package). Unset = every link silently falls back to the app-served
# <ADVANCE_PUBLIC_URL>/stage-plot/... URL.
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# DROPBOX_REFRESH_TOKEN=

# FSQ regular-vehicle parking notice recipient.
# ADVANCE_FSQ_PARKING_NOTICE_TO=Mtully@3cdc.org
