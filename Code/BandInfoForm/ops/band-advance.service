# Reference copy of /etc/systemd/system/band-advance.service (2026-09-13 audit #23):
# threaded workers with a 120s timeout so a large stage-plot upload or a slow
# Spanish translation can't kill a band's submission mid-request, and a 120s
# graceful shutdown so a restart lets in-flight requests finish.
#
# Bound to 127.0.0.1, not 0.0.0.0 (audit 2026-09-16 security #6): the app was
# reachable on the LAN port directly, so anything on the network could spoof
# CF-Connecting-IP and skip Cloudflare (and its bot/rate protections)
# entirely — the gate's own IP-trust fix (app.py _client_ip) only actually
# holds with this bind change deployed alongside it. n8n now reaches this
# app via host.docker.internal:8097 (extra_hosts in n8n's docker-compose.yml
# on the VM, NOT this repo — see the batch-3 report for the exact deploy
# order) instead of the LAN IP every workflow JSON used to carry.
[Unit]
Description=3CDC Band Advance Form
After=network.target docker.service

[Service]
User=brian
WorkingDirectory=/opt/band-advance
EnvironmentFile=/opt/band-advance/advance.env
ExecStart=/opt/band-advance/venv/bin/gunicorn --worker-class gthread -w 4 --threads 4 --timeout 120 --graceful-timeout 120 -b 127.0.0.1:8097 app:app
Restart=always

[Install]
WantedBy=multi-user.target
