[Unit]
Description=Band Advance — alert if the 9am lifecycle check didn't run
After=network-online.target

[Service]
Type=oneshot
User=brian
EnvironmentFile=/opt/band-advance/advance.env
ExecStart=/bin/bash -c 'curl -sS -m 60 -X POST -H "X-Advance-Token: $ADVANCE_INTERNAL_TOKEN" http://127.0.0.1:8097/internal/lifecycle-watchdog'
