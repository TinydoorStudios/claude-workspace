# /opt/digibot/.env — root-owned, mode 600. install.sh fills the secrets; edit the rest here.
DIGIBOT_DB_PASSWORD=change-me

# DiGiCo wiki (Wiki.js on CT 101 :3002) — all pages indexed
DIGICO_WIKI_URL=http://192.168.200.126:3002
DIGICO_WIKI_KEY=
DIGICO_PUBLIC_URL=https://digico.tinydoorstudios.com
DIGICO_EXCLUDE_PATHS=venue/teachings-inbox
DIGIBOT_INBOX_PATH=venue/teachings-inbox

# Live Sound KB (Wiki.js on CT 101 :3000) — only these slugs are indexed (tier 3, "how we do it")
KB_WIKI_URL=http://192.168.200.126:3000
KB_WIKI_KEY=
KB_PUBLIC_URL=https://kb.tinydoorstudios.com
KB_PATHS=console-digico-q225,venue-memorial-hall,venue-fountain-square,sop-memo-reaper-record-chain,sop-fsq-m32-failover,dante-cisco-switch-config,multitrack-recording-workflow,reverb-reference-memo,sop-fsq-la-network-manager,sop-fsq-hotshot-comms

# Groq (free tier). First model that isn't rate-limited answers.
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
DIGIBOT_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
DIGIBOT_MAX_TOOL_ROUNDS=3
DIGIBOT_TOP_K=5
DIGIBOT_CHUNK_CHARS=1200
DIGIBOT_RETRY_WAIT_S=20

# Slack identities. Teachers = who may "teach:" / 📌. Home channel = answers without an @mention.
DIGIBOT_OWNER=UHSLD08SV
DIGIBOT_TEACHERS=UHSLD08SV
DIGIBOT_HOME_CHANNEL=
DIGIBOT_BOT_USER_ID=

DIGIBOT_EMBED_MODEL=BAAI/bge-small-en-v1.5
