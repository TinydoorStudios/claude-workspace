# Deployed to /etc/spl-monitor-memo.env on the VM (chmod 600). Real values —
# this is the Memorial Hall counterpart to /etc/spl-monitor.env (FSQ). Kept out
# of config.json same as FSQ's rig IP.

SPL_SOURCE=smaart

SMAART_HOST=50.5.85.76
SMAART_PORT=26000
# No password set on this rig's Smaart API.

# Single calibrated input on this rig — auto-detected, no need to pin, but
# here for reference: device "Dante Virtual Soundcard", channel "SPL".
# SMAART_DEVICE=Dante Virtual Soundcard
# SMAART_CHANNEL=SPL

SPL_HOST=127.0.0.1
SPL_PORT=8091

TZ=America/New_York
