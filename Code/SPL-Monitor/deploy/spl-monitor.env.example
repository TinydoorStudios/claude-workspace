# Copy to /etc/spl-monitor.env on the Pi and fill in. Keep this file private (chmod 600).
# These override config.json so the work IP and API password stay out of the repo.

SPL_SOURCE=smaart

# The work network's public IP and the forwarded Smaart API port
SMAART_HOST=PUT_WORK_PUBLIC_IP_HERE
SMAART_PORT=26000

# Set a password on the Smaart API (Options > Preferences > API) and put it here.
# Strongly recommended since 26000 will be reachable from the internet.
SMAART_PASSWORD=PUT_API_PASSWORD_HERE

# Optional: pin a specific device/channel if Smaart exposes more than one calibrated input
# SMAART_DEVICE=
# SMAART_CHANNEL=

# Bind the dashboard to localhost only — Cloudflare tunnel connects to it locally.
# Do NOT expose this port to the internet directly; the tunnel is the front door.
SPL_HOST=127.0.0.1
SPL_PORT=8090
