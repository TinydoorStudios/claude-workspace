#!/usr/bin/env bash
# Show-pipeline regression guard (pipeline-fix, 2026-09-14). Runs the selftest
# only when a staged file touches the code or templates the .ses/packet build
# depends on, so ordinary commits stay fast. Tracked in-repo, wired via
# core.hooksPath; if it ever stops firing after a re-clone:
#   git config core.hooksPath audio/_skills/git-hooks
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
if git diff --cached --name-only | grep -qE '^audio/(_shared/|_skills/show-deep-build/scripts/|show-packet-builder-template\.py|[^/]+/Q225 SES Patcher SOP/|[^/]+/_TEMPLATE/[^/]+\.ses$)'; then
  echo "pre-commit: pipeline code/template staged — running selftest"
  python3 "$ROOT/audio/_shared/selftest.py" --quick || { echo "pre-commit: selftest FAILED — commit blocked"; exit 1; }
fi
exit 0
